{
  "manifest_version": 3,
  "name": "小红书资源下载",
  "version": "1.0.2",
  "description": "小红书无水印高清原图与视频下载器，核心算法由 WASM 驱动",
  "permissions": [
    "storage",
    "downloads",
    "tabs"
  ],
  "host_permissions": [
    "https://www.xiaohongshu.com/*",
    "https://*.xiaohongshu.com/*",
    "https://*.xhscdn.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "小红书资源下载",
    "default_icon": {
      "16": "icons/doudou_16.png",
      "48": "icons/doudou_48.png",
      "128": "icons/doudou_128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/doudou_16.png",
    "48": "icons/doudou_48.png",
    "128": "icons/doudou_128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://*.xiaohongshu.com/*"
      ],
      "exclude_matches": [
        "https://creator.xiaohongshu.com/*",
        "https://ark.xiaohongshu.com/*"
      ],
      "js": [
        "src/wasm-loader.js",
        "src/downloader.js"
      ],
      "css": [
        "src/downloader.css"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "build/xiaohongshu.wasm",
        "src/inject.js",
        "icons/*"
      ],
      "matches": [
        "https://www.xiaohongshu.com/*",
        "https://*.xiaohongshu.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; img-src * data: blob: filesystem:;"
  }
}
